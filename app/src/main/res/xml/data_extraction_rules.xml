<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ (Android 12+).
    The Room database and DataStore contain PAN numbers and sensitive financial data.
    Exclude them from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room database (PAN numbers, rent amounts, landlord details) -->
        <exclude domain="database" path="rent_log_db" />
        <exclude domain="database" path="rent_log_db-shm" />
        <exclude domain="database" path="rent_log_db-wal" />
        <!-- DataStore lives under files/datastore -->
        <exclude domain="file" path="datastore" />
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions for device-to-device transfer -->
        <exclude domain="database" path="rent_log_db" />
        <exclude domain="database" path="rent_log_db-shm" />
        <exclude domain="database" path="rent_log_db-wal" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
