<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 30 and below.
    The SQLite database contains PAN numbers and financial data — exclude it from backups
    to prevent sensitive data leaking via Google Drive or device-to-device transfer.
    DataStore preferences are excluded as well (may contain landlord PAN).
-->
<full-backup-content>
    <!-- Exclude the Room database (contains PAN numbers, rent amounts) -->
    <exclude domain="database" path="rent_log_db" />
    <exclude domain="database" path="rent_log_db-shm" />
    <exclude domain="database" path="rent_log_db-wal" />

    <!-- DataStore lives under files/datastore -->
    <exclude domain="file" path="datastore" />
</full-backup-content>
